{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/brettinternet/tell/main/tell.schema.json",
  "title": "Tell personal configuration",
  "description": "For user config, .git/tell.yaml, or an explicit --config file. Personal Slack routes support exactly one run, notify, or send action. Shared tell.yaml uses tell.shared.schema.json. Run tell config check for authoritative validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1, "default": 1 },
    "timeout": {
      "allOf": [{ "$ref": "#/definitions/nonBlankString" }],
      "description": "Positive Go duration, such as 10s or 1m30s. Tell checks positivity and overflow.",
      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h)(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h))*$",
      "default": "10s"
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": { "enum": ["stderr", "desktop", "apprise", "herdr", "command"], "default": "stderr" },
        "command": {
          "description": "Literal executable and arguments; body is sent on stdin. Personal files only.",
          "type": "array",
          "minItems": 1,
          "items": [{ "type": "string", "pattern": "\\S", "not": { "pattern": "\u0000" } }],
          "additionalItems": { "type": "string", "not": { "pattern": "\u0000" } }
        }
      }
    },
    "apprise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "allOf": [{ "$ref": "#/definitions/nonBlankString" }],
          "description": "Local provider config path, relative to this file. No shell expansion.",
          "not": { "pattern": "://" }
        },
        "tag": { "$ref": "#/definitions/nonBlankString", "description": "Apprise tag expression." },
        "format": { "enum": ["text", "markdown", "html"] }
      }
    },
    "herdr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": { "$ref": "#/definitions/nonBlankString", "description": "Existing Herdr session name; default selects the default session." }
      }
    },
    "send": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": { "enum": ["hcom", "herdr"] },
        "to": { "$ref": "#/definitions/string", "description": "One exact recipient. Delivery checks recipient validity; no broadcast fallback." },
        "from": { "allOf": [{ "$ref": "#/definitions/string" }], "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$", "default": "tell-automation" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["redact", "reject"], "default": "redact" }
      }
    },
    "listen": {
      "description": "Personal-only inbound configuration. Slack Socket Mode and signed GitHub repository webhooks support literal run argv and native notify/send actions with single-pass scalar envelope templates. Route lists replace whole lists.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_token_env"],
          "properties": {
            "app_token_env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Environment variable name holding a connections:write app token, never the token itself. Removed from every Tell child environment."
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secret_env", "repository_ids"],
          "properties": {
            "secret_env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Environment variable name holding the dedicated repository-webhook secret, never the secret itself. Removed from every Tell child environment."
            },
            "repository_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
              "description": "Positive GitHub repository.id allowlist checked against each signed webhook body."
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addr": {
              "type": "string",
              "pattern": "^(?:127(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
              "default": "127.0.0.1:8787",
              "description": "Literal IPv4/IPv6 loopback address and port only; never a wildcard, LAN address, or DNS name."
            }
          }
        },
        "routes": {
          "type": "array",
          "description": "Whole-list replacement. Matching routes run literal argv commands; Tell bounds execution and discards child output.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
              "source": { "enum": ["slack", "github"] },
              "type": { "allOf": [{ "$ref": "#/definitions/nonBlankString" }], "maxLength": 128 },
              "match": {
                "type": "object",
                "description": "AND of exact typed scalar equality or {prefix: STRING} predicates on paths inside event data.",
                "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$" },
                "additionalProperties": {
                  "oneOf": [
                    { "$ref": "#/definitions/string" },
                    { "type": "number" },
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["prefix"],
                      "properties": { "prefix": { "$ref": "#/definitions/string" } }
                    }
                  ]
                }
              },
              "run": {
                "description": "Literal argv; no shell or interpolation. Envelope JSON is stdin, child output is discarded.",
                "type": "array",
                "minItems": 1,
                "items": [{ "$ref": "#/definitions/nonBlankString" }],
                "additionalItems": { "$ref": "#/definitions/string" }
              },
              "notify": {
                "type": "object",
                "additionalProperties": false,
                "required": ["message"],
                "properties": {
                  "message": { "$ref": "#/definitions/templateString", "description": "Message with single-pass ${path} envelope scalar placeholders; $${ escapes a literal opener." },
                  "title": { "type": "string", "description": "Optional title with the same envelope placeholder grammar; empty explicitly suppresses the default project title." },
                  "type": { "enum": ["info", "success", "warning", "failure"], "default": "info" },
                  "via": { "enum": ["stderr", "desktop", "apprise", "herdr", "command"], "description": "Static override; otherwise inherit effective notify.via." },
                  "herdr_session": { "$ref": "#/definitions/staticSelector", "description": "Static session override; otherwise inherit herdr.session." },
                  "apprise_tag": { "$ref": "#/definitions/staticSelector", "description": "Static Apprise tag override; otherwise inherit apprise.tag." }
                }
              },
              "send": {
                "type": "object",
                "additionalProperties": false,
                "required": ["message"],
                "properties": {
                  "message": { "$ref": "#/definitions/templateString", "description": "Message with single-pass ${path} envelope scalar placeholders; $${ escapes a literal opener." },
                  "via": { "enum": ["hcom", "herdr"], "description": "Static override; otherwise inherit send.via." },
                  "to": { "$ref": "#/definitions/staticSelector", "description": "One static exact recipient; never interpolated." },
                  "herdr_session": { "$ref": "#/definitions/staticSelector", "description": "Static session override; otherwise inherit herdr.session." },
                  "intent": { "const": "inform", "default": "inform", "description": "Inform only; external event content is untrusted." }
                }
              }
            },
            "oneOf": [
              { "required": ["run"] },
              { "required": ["notify"] },
              { "required": ["send"] }
            ]
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_targets": { "type": "boolean", "default": false, "description": "Allow MCP agents to override routes and recipients, not executable paths or policy." }
      }
    }
  },
  "definitions": {
    "string": { "type": "string", "not": { "pattern": "[\u0000\u001b\r\n]" } },
    "nonBlankString": { "allOf": [{ "$ref": "#/definitions/string" }, { "pattern": "\\S" }] },
    "templateString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "staticSelector": { "allOf": [{ "$ref": "#/definitions/nonBlankString" }], "not": { "pattern": "\\$\\$?\\{" } }
  }
}
