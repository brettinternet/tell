{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/brettinternet/tell/main/tell.shared.schema.json",
  "title": "Tell shared project configuration",
  "description": "Shared tell.yaml cannot choose destinations or personal policy. Inbound sources and all listen.routes actions are personal-only; use personal configuration for all listen settings.",
  "allOf": [
    { "$ref": "tell.schema.json" },
    {
      "properties": {
        "listen": false,
        "notify": { "properties": { "via": false, "command": false } },
        "apprise": { "properties": { "config": false } },
        "herdr": { "properties": { "session": false } },
        "send": { "properties": { "via": false, "to": false, "from": false } },
        "secrets": { "properties": { "policy": false } },
        "mcp": { "properties": { "agent_targets": false } }
      }
    }
  ]
}
